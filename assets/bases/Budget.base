filters:
  and:
    - file.inFolder("wiki/{{project_key}}/pm/records/budgets")
    - 'project == "{{project_key}}"'
    - 'type == "budget-snapshot"'
properties:
  file.name:
    displayName: Snapshot
  period:
    displayName: Period
  health:
    displayName: Health
  currency:
    displayName: Currency
  approved_budget:
    displayName: Budget
  actual_cost:
    displayName: Actual
  actual_hours:
    displayName: Hours
  committed_cost:
    displayName: Committed
  estimate_to_complete:
    displayName: ETC
  estimate_at_completion:
    displayName: EAC
  forecast_variance:
    displayName: Variance
  unpriced_change:
    displayName: Unpriced change
  valid_as_of:
    displayName: Valid as of
views:
  - type: table
    name: Snapshots
    order:
      - file.name
      - period
      - health
      - currency
      - approved_budget
      - actual_cost
      - actual_hours
      - committed_cost
      - estimate_to_complete
      - estimate_at_completion
      - forecast_variance
      - unpriced_change
      - valid_as_of

