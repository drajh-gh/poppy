filters:
  and:
    - file.inFolder("wiki/{{project_key}}/pm/records/health")
    - 'project == "{{project_key}}"'
    - 'type == "health-snapshot"'
properties:
  file.name:
    displayName: Snapshot
  period:
    displayName: Period
  overall_health:
    displayName: Overall
  outcome_health:
    displayName: Outcome
  scope_health:
    displayName: Scope
  schedule_health:
    displayName: Schedule
  budget_health:
    displayName: Budget
  capacity_health:
    displayName: Capacity
  delivery_health:
    displayName: Delivery
  quality_health:
    displayName: Quality
  freshness_health:
    displayName: Freshness
  valid_as_of:
    displayName: Valid as of
views:
  - type: table
    name: Latest
    limit: 12
    order:
      - file.name
      - period
      - overall_health
      - outcome_health
      - scope_health
      - schedule_health
      - budget_health
      - capacity_health
      - delivery_health
      - quality_health
      - freshness_health
      - valid_as_of

