filters:
  and:
    - file.inFolder("wiki/{{project_key}}/pm/records/research")
    - 'type == "analysis"'
    - or:
        - 'record_kind == "research-brief"'
        - 'record_kind == "repository-assessment"'
        - 'record_kind == "research-handoff"'
properties:
  file.name:
    displayName: Research record
  record_kind:
    displayName: Kind
  priority_lane:
    displayName: Lane
  status:
    displayName: Status
  confidence:
    displayName: Confidence
  assessment_outcome:
    displayName: Repository outcome
  review_after:
    displayName: Review after
views:
  - type: table
    name: Research
    order:
      - file.name
      - record_kind
      - priority_lane
      - status
      - confidence
      - assessment_outcome
      - review_after
