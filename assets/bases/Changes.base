filters:
  and:
    - file.inFolder("wiki/{{project_key}}/pm/records/changes")
    - 'project == "{{project_key}}"'
    - 'type == "change-request"'
properties:
  file.name:
    displayName: Change
  classification:
    displayName: Classification
  requested_by:
    displayName: Requested by
  pm_state:
    displayName: State
  approval_status:
    displayName: Approval
  approver:
    displayName: Approver
  cost_impact:
    displayName: Cost impact
  schedule_impact:
    displayName: Schedule impact
views:
  - type: table
    name: Pending
    filters:
      or:
        - 'approval_status == "pending"'
        - 'classification == "uncertain"'
    order:
      - file.name
      - classification
      - requested_by
      - approval_status
      - approver
      - cost_impact
      - schedule_impact
  - type: table
    name: All
    order:
      - file.name
      - classification
      - pm_state
      - approval_status
      - requested_by
      - approver
