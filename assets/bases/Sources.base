filters:
  and:
    - file.inFolder("raw/{{project_key}}")
    - 'type == "source"'
formulas:
  source_family: 'file.folder.replace("raw/{{project_key}}/", "")'
properties:
  file.name:
    displayName: Source
  source_system:
    displayName: System
  source_id:
    displayName: Source ID
  captured:
    displayName: Captured
  language:
    displayName: Language
  evidence_grade:
    displayName: Grade
  sensitivity:
    displayName: Sensitivity
  immutable:
    displayName: Immutable
  formula.source_family:
    displayName: Family
views:
  - type: table
    name: Sources
    groupBy:
      property: formula.source_family
      direction: ASC
    order:
      - file.name
      - formula.source_family
      - source_system
      - source_id
      - captured
      - language
      - evidence_grade
      - sensitivity
      - immutable

