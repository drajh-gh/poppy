filters:
  and:
    - file.inFolder("wiki/{{project_key}}/pm/records/stakeholders")
    - 'project == "{{project_key}}"'
    - 'type == "analysis"'
    - 'record_kind == "stakeholder"'
properties:
  file.name:
    displayName: Stakeholder
  organization:
    displayName: Organization
  role:
    displayName: Role
  pm_state:
    displayName: State
  influence:
    displayName: Influence
  interest:
    displayName: Interest
  preferred_channel:
    displayName: Channel
  cadence:
    displayName: Cadence
  last_touch:
    displayName: Last touch
views:
  - type: table
    name: Active
    filters: 'pm_state == "active"'
    order:
      - file.name
      - organization
      - role
      - influence
      - interest
      - preferred_channel
      - cadence
      - last_touch
  - type: table
    name: All
    order:
      - file.name
      - organization
      - role
      - pm_state
      - last_touch
