filters:
  and:
    - file.inFolder("wiki/{{project_key}}/pm/records/commitments")
    - 'project == "{{project_key}}"'
    - 'type == "commitment"'
formulas:
  days_until_due: 'if(due, (date(due) - today()).days, "")'
  due_state: 'if(!due, "⚪ No date", if(pm_state == "fulfilled", "✅ Fulfilled", if(date(due) < today(), "🔴 Overdue", if((date(due) - today()).days <= 7, "🟠 Due soon", "🟢 Scheduled"))))'
properties:
  file.name:
    displayName: Commitment
  owner:
    displayName: Owner
  counterparty:
    displayName: Counterparty
  due:
    displayName: Due
  pm_state:
    displayName: State
  confirmation_status:
    displayName: Confirmation
  formula.due_state:
    displayName: Due state
  formula.days_until_due:
    displayName: Days
views:
  - type: table
    name: Due
    filters:
      and:
        - 'pm_state != "fulfilled"'
        - 'pm_state != "cancelled"'
    order:
      - file.name
      - owner
      - counterparty
      - due
      - formula.due_state
      - formula.days_until_due
      - confirmation_status
  - type: table
    name: All
    order:
      - file.name
      - pm_state
      - owner
      - counterparty
      - due
      - confirmation_status

