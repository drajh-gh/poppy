filters:
  and:
    - file.inFolder("raw/{{project_key}}/pm-os/runs")
    - 'type == "source"'
    - 'record_kind == "orchestration-run"'
    - 'orchestrator == "poppy"'
properties:
  file.name:
    displayName: Run
  source_system:
    displayName: System
  source_id:
    displayName: Run ID
  orchestrator:
    displayName: Partner
  captured:
    displayName: Captured
  interaction_class:
    displayName: Class
  risk:
    displayName: Risk
  preflight_confidence:
    displayName: Preflight
  postflight_confidence:
    displayName: Postflight
  verdict:
    displayName: Verdict
views:
  - type: table
    name: Runs
    order:
      - file.name
      - source_system
      - orchestrator
      - source_id
      - captured
      - interaction_class
      - risk
      - preflight_confidence
      - postflight_confidence
      - verdict
