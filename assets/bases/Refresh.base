filters:
  and:
    - file.inFolder("wiki/{{project_key}}")
    - 'project == "{{project_key}}"'
    - 'status != "superseded"'
formulas:
  review_state: 'if(!review_after, "⚪ Unscheduled", if(date(review_after) < today(), "🔴 Overdue", if(date(review_after) == today(), "🟠 Due", "🟢 Scheduled")))'
  days_until_review: 'if(review_after, (date(review_after) - today()).days, "")'
properties:
  file.name:
    displayName: Page
  type:
    displayName: Type
  status:
    displayName: Knowledge state
  pm_state:
    displayName: PM state
  valid_as_of:
    displayName: Valid as of
  review_after:
    displayName: Review after
  formula.review_state:
    displayName: Review state
  formula.days_until_review:
    displayName: Days
  confidence:
    displayName: Confidence
views:
  - type: table
    name: Needs refresh
    filters:
      or:
        - "!review_after"
        - date(review_after) <= today()
        - 'status == "needs-review"'
        - 'confidence == "low"'
    order:
      - file.name
      - type
      - status
      - pm_state
      - valid_as_of
      - review_after
      - formula.review_state
      - formula.days_until_review
      - confidence
  - type: table
    name: Schedule
    order:
      - file.name
      - type
      - status
      - pm_state
      - valid_as_of
      - review_after
      - formula.review_state
      - formula.days_until_review

