filters:
  and:
    - file.inFolder("wiki/{{project_key}}/decisions")
    - 'project == "{{project_key}}"'
    - 'type == "decision"'
properties:
  file.name:
    displayName: Decision
  status:
    displayName: Status
  decision_date:
    displayName: Date
  evidence_grade:
    displayName: Grade
  updated:
    displayName: Updated
  review_after:
    displayName: Review after
views:
  - type: table
    name: Decisions
    order:
      - file.name
      - status
      - decision_date
      - evidence_grade
      - updated
      - review_after
