{
  "description": "Bounded Poppy Housekeeping guards and opt-in Scribe continuity checkpoints.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(resume|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/housekeeping_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\housekeeping_hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 240
          },
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/scribe_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\scribe_hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 2200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/scribe_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\scribe_hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 2200
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/scribe_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\scribe_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/scribe_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\scribe_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/scribe_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\scribe_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__codex_app__(set_thread_title|set_thread_archived)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/housekeeping_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\housekeeping_hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 240
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__codex_app__(set_thread_title|set_thread_archived)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/housekeeping_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\housekeeping_hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 240
          }
        ]
      }
    ]
  }
}
