{
  "description": "Bounded Poppy Housekeeping lifecycle guards.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(resume|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/housekeeping_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\housekeeping_hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 240
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/housekeeping_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\housekeeping_hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 160
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__codex_app__(set_thread_title|set_thread_archived)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/housekeeping_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\housekeeping_hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 240
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__codex_app__(set_thread_title|set_thread_archived)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/housekeeping_hook.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\housekeeping_hook.py\"",
            "timeout": 3,
            "additionalContextLimit": 240
          }
        ]
      }
    ]
  }
}
