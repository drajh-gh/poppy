{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/authority/authority-query/v1",
  "title": "Poppy v2 authority query",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.authority.authority-query",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "query_id", "scope", "requested_authority", "evaluated_at", "candidate_source_refs", "candidate_set_digest", "requester_kind", "requester_ref", "current_task_ref"],
  "properties": {
    "$schema": {"const": "poppy://schema/authority/authority-query/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "query_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
    "scope": {"$ref": "poppy://schema/authority/claim-scope/v1"},
    "requested_authority": {"enum": ["claim_decision", "effect_execution"]},
    "evaluated_at": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/timestamp"},
    "candidate_source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidate_set_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "requester_kind": {"enum": ["root", "internal_worker", "user_owned_task", "human_operator"]},
    "requester_ref": {"type": "string", "minLength": 1},
    "current_task_ref": {"type": ["string", "null"]}
  },
  "unevaluatedProperties": false
}
