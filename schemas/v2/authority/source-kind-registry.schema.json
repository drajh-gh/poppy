{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/authority/source-kind-registry/v1",
  "title": "Poppy v2 source-kind classification registry",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.authority.source-kind-registry",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "registry_id", "registry_version", "registry_digest", "source_kinds"],
  "properties": {
    "$schema": {"const": "poppy://schema/authority/source-kind-registry/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "registry_id": {"const": "poppy.v2.source-kinds"},
    "registry_version": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/semver"},
    "registry_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "source_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_kind_id", "data_class", "owner_kind", "authority_semantics", "lifetime"],
        "properties": {
          "source_kind_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
          "data_class": {"enum": ["external_constraint", "instruction", "decision", "configuration", "preference", "evidence", "derived_state", "telemetry", "enforcement", "documentation", "artifact"]},
          "owner_kind": {"enum": ["platform", "human", "operator", "engineering", "provider", "kernel", "runtime", "release"]},
          "authority_semantics": {"enum": ["grant", "constrain", "reference_only", "none"]},
          "lifetime": {"enum": ["turn", "run", "task", "until_expiry", "until_superseded", "artifact", "release", "runtime", "retention_window"]}
        },
        "unevaluatedProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
