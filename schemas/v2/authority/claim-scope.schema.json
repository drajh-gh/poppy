{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/authority/claim-scope/v1",
  "title": "Poppy v2 exact authority scope",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.authority.claim-scope",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "subject_kind", "subject_id", "subject_digest", "data_class", "objective_digest", "plan_revision", "scope_digest"],
  "properties": {
    "$schema": {"const": "poppy://schema/authority/claim-scope/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "subject_kind": {"enum": ["claim", "effect"]},
    "subject_id": {"type": "string", "minLength": 1},
    "subject_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "data_class": {"enum": ["external_constraint", "instruction", "decision", "configuration", "preference", "evidence", "derived_state", "telemetry", "enforcement", "documentation", "artifact"]},
    "objective_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "scope_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"}
  },
  "unevaluatedProperties": false
}
