{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/authority/authority-resolution/v1",
  "title": "Poppy v2 typed authority resolution",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.authority.authority-resolution",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "resolution_id", "query_id", "scope_digest", "subject_id", "subject_digest", "objective_digest", "plan_revision", "evaluated_at", "candidate_set_digest", "checks", "outcome", "authority_ref", "selected_candidate_ids", "conflict_candidate_ids", "reason_codes", "resolved_at", "resolution_digest"],
  "properties": {
    "$schema": {"const": "poppy://schema/authority/authority-resolution/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "resolution_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
    "query_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
    "scope_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "subject_id": {"type": "string", "minLength": 1},
    "subject_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "objective_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "evaluated_at": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/timestamp"},
    "candidate_set_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "checks": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["applicability", "authority", "specificity", "freshness", "safety", "conflict"]}},
    "outcome": {"enum": ["authorized", "denied", "unresolved_conflict", "gray"]},
    "authority_ref": {"type": ["string", "null"]},
    "selected_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"}},
    "conflict_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"}},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}},
    "resolved_at": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/timestamp"},
    "resolution_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"}
  },
  "unevaluatedProperties": false
}
