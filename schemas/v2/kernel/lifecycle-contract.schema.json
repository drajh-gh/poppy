{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/kernel/lifecycle-contract/v1",
  "title": "Poppy v2 kernel lifecycle contract",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.kernel.lifecycle-contract",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "run_id", "states", "conditional_states", "terminal_states", "allowed_transitions", "plan_revision", "transitions", "plan_revisions", "authority_binding", "evaluation_binding", "attempted_effects", "persistence", "outcome"],
  "properties": {
    "$schema": {"const": "poppy://schema/kernel/lifecycle-contract/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "run_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
    "states": {
      "type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true,
      "items": {"enum": ["RECEIVED", "TRIAGED", "CONTEXT_RESOLVED", "ORIENTED", "PLANNED", "AWAITING_AUTHORITY", "EXECUTING", "JOINING", "EVALUATING", "PERSISTING", "SUCCEEDED", "LIMITED", "BLOCKED", "CANCELLED", "FAILED"]}
    },
    "conditional_states": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "items": {"enum": ["ORIENTED", "AWAITING_AUTHORITY", "PERSISTING"]}
    },
    "terminal_states": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "items": {"enum": ["SUCCEEDED", "LIMITED", "BLOCKED", "CANCELLED", "FAILED"]}
    },
    "allowed_transitions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["source_state", "event_type", "destination_state", "required_guard_codes"],
        "properties": {
          "source_state": {"enum": ["RECEIVED", "TRIAGED", "CONTEXT_RESOLVED", "ORIENTED", "PLANNED", "AWAITING_AUTHORITY", "EXECUTING", "JOINING", "EVALUATING", "PERSISTING"]},
          "event_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"},
          "destination_state": {"enum": ["TRIAGED", "CONTEXT_RESOLVED", "ORIENTED", "PLANNED", "AWAITING_AUTHORITY", "EXECUTING", "JOINING", "EVALUATING", "PERSISTING", "SUCCEEDED", "LIMITED", "BLOCKED", "CANCELLED", "FAILED"]},
          "required_guard_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^GRD-[A-Z]{3}-[0-9]{3}$"}}
        },
        "unevaluatedProperties": false
      }
    },
    "plan_revision": {"type": "integer", "minimum": 1},
    "transitions": {"type": "array", "minItems": 1, "items": {"$ref": "poppy://schema/kernel/transition-record/v1"}},
    "plan_revisions": {"type": "array", "items": {"$ref": "poppy://schema/kernel/plan-revision-record/v1"}},
    "authority_binding": {
      "type": ["object", "null"],
      "properties": {
        "plan_revision": {"type": "integer", "minimum": 1},
        "valid": {"type": "boolean"},
        "outcome": {"enum": ["authorized", "denied", "missing", "unresolved_conflict"]}
      },
      "required": ["plan_revision", "valid", "outcome"],
      "unevaluatedProperties": false
    },
    "evaluation_binding": {
      "type": ["object", "null"],
      "properties": {
        "plan_revision": {"type": "integer", "minimum": 1},
        "valid": {"type": "boolean"},
        "authorized_durable_delta": {"type": "boolean"},
        "state": {"enum": ["supported", "contradicted", "gray"]}
      },
      "required": ["plan_revision", "valid", "authorized_durable_delta", "state"],
      "unevaluatedProperties": false
    },
    "attempted_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^effect[.-][a-z0-9.-]+$"}},
    "persistence": {
      "type": "object",
      "required": ["entered", "persisted", "durable_delta_digest"],
      "properties": {
        "entered": {"type": "boolean"},
        "persisted": {"type": "boolean"},
        "durable_delta_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "unevaluatedProperties": false
    },
    "outcome": {"$ref": "poppy://schema/kernel/run-outcome/v1"}
  },
  "unevaluatedProperties": false
}
