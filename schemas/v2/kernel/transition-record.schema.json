{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/kernel/transition-record/v1",
  "title": "Poppy v2 immutable kernel transition record",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.kernel.transition-record",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "transition_id", "run_id", "sequence", "source_state", "event", "guard_results", "destination_state", "plan_revision", "previous_transition_digest", "transitioned_at", "transition_digest"],
  "properties": {
    "$schema": {"const": "poppy://schema/kernel/transition-record/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "transition_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
    "run_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
    "sequence": {"type": "integer", "minimum": 1},
    "source_state": {"enum": ["RECEIVED", "TRIAGED", "CONTEXT_RESOLVED", "ORIENTED", "PLANNED", "AWAITING_AUTHORITY", "EXECUTING", "JOINING", "EVALUATING", "PERSISTING", "SUCCEEDED", "LIMITED", "BLOCKED", "CANCELLED", "FAILED"]},
    "event": {"$ref": "poppy://schema/kernel/event/v1"},
    "guard_results": {"type": "array", "uniqueItems": true, "items": {"$ref": "poppy://schema/kernel/guard-result/v1"}},
    "destination_state": {"enum": ["RECEIVED", "TRIAGED", "CONTEXT_RESOLVED", "ORIENTED", "PLANNED", "AWAITING_AUTHORITY", "EXECUTING", "JOINING", "EVALUATING", "PERSISTING", "SUCCEEDED", "LIMITED", "BLOCKED", "CANCELLED", "FAILED"]},
    "plan_revision": {"type": "integer", "minimum": 1},
    "previous_transition_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "transitioned_at": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/timestamp"},
    "transition_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"}
  },
  "unevaluatedProperties": false
}
