{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/kernel/guard-result/v1",
  "title": "Poppy v2 typed transition guard result",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.kernel.guard-result",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "guard_code", "outcome", "reason_codes", "evaluated_at"],
  "properties": {
    "$schema": {"const": "poppy://schema/kernel/guard-result/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "guard_code": {"type": "string", "pattern": "^GRD-[A-Z]{3}-[0-9]{3}$"},
    "outcome": {"enum": ["passed", "failed", "gray"]},
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}
    },
    "evaluated_at": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/timestamp"}
  },
  "unevaluatedProperties": false
}
