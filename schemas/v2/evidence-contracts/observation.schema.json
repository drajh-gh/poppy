{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/evidence/observation/v1",
  "title": "Poppy v2 evidence observation",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.evidence.observation",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "observation_id", "claim_id", "role", "observed_at", "coverage", "limitations", "content_ref", "content_digest", "usable", "material"],
  "properties": {
    "$schema": {"const": "poppy://schema/evidence/observation/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "observation_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
    "claim_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
    "role": {"enum": ["supports", "contradicts", "contextual"]},
    "observed_at": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/timestamp"},
    "coverage": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "content_ref": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/artifactLocator"},
    "content_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "usable": {"type": "boolean"},
    "material": {"type": "boolean"}
  },
  "unevaluatedProperties": false
}
