{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/evidence/claim/v1",
  "title": "Poppy v2 evidence claim",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.evidence.claim",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "claim_id", "kind", "statement", "material", "value", "valid_as_of", "created_at"],
  "properties": {
    "$schema": {"const": "poppy://schema/evidence/claim/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "claim_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "statement": {"type": "string", "minLength": 1},
    "material": {"type": "boolean"},
    "value": {"type": ["object", "array", "string", "number", "boolean", "null"]},
    "valid_as_of": {
      "anyOf": [
        {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/timestamp"},
        {"type": "null"}
      ]
    },
    "created_at": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/timestamp"}
  },
  "unevaluatedProperties": false
}
