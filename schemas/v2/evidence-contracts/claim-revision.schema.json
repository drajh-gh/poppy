{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/evidence/claim-revision/v1",
  "title": "Poppy v2 immutable claim revision",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.evidence.claim-revision",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "claim_id", "revision", "state", "reason_codes", "required_dependencies", "dependency_reasons", "content_digest", "recorded_at"],
  "properties": {
    "$schema": {"const": "poppy://schema/evidence/claim-revision/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "claim_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
    "revision": {"type": "integer", "minimum": 1},
    "state": {"enum": ["supported", "contradicted", "gray"]},
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}
    },
    "required_dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"}
    },
    "dependency_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["dependency_claim_id", "reason_code"],
        "properties": {
          "dependency_claim_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
          "reason_code": {"enum": ["required_dependency_gray", "required_dependency_contradicted"]}
        },
        "unevaluatedProperties": false
      }
    },
    "content_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "recorded_at": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/timestamp"}
  },
  "unevaluatedProperties": false
}
