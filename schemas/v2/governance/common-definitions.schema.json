{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/governance/common-definitions/v1",
  "title": "Poppy v2 common structural definitions",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.governance.common-definitions",
  "$defs": {
    "artifactLocator": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^POP-V2-(00[1-9]|01[0-2])$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
    },
    "manifestEntryId": {
      "type": "string",
      "pattern": "^(schema|invariant)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "schemaId": {
      "type": "string",
      "pattern": "^poppy://schema/[a-z0-9-]+/[a-z0-9-]+/v[1-9][0-9]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "stableCode": {
      "type": "string",
      "pattern": "^POP2-(SHP|INV|BEH|INT|REL)-[A-Z]{3}-[0-9]{3}$"
    },
    "testId": {
      "type": "string",
      "pattern": "^TV2-[A-Z]{3}-[0-9]{3}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
