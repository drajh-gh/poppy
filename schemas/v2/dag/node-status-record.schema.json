{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"poppy://schema/dag/node-status-record/v1","title":"Poppy v2 immutable node status record","x-poppy-schema-version":"1.0.0","x-poppy-manifest-entry":"schema.dag.node-status-record","type":"object","required":["$schema","x-poppy-schema-version","status_record_id","run_id","plan_revision","node_id","sequence","status","reason_codes","recorded_at","previous_status_digest","status_digest"],"properties":{"$schema":{"const":"poppy://schema/dag/node-status-record/v1"},"x-poppy-schema-version":{"const":"1.0.0"},"status_record_id":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},"run_id":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},"plan_revision":{"type":"integer","minimum":1},"node_id":{"type":"string","pattern":"^node[.][a-z0-9]+(?:[.][a-z0-9]+)*$"},"sequence":{"type":"integer","minimum":1},"status":{"enum":["PLANNED","BLOCKED","READY","RUNNING","SUCCEEDED","LIMITED","FAILED","CANCELLED"]},"reason_codes":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}},"recorded_at":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/timestamp"},"previous_status_digest":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"},"status_digest":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/digest"}},"unevaluatedProperties":false}
