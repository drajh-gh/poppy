{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"poppy://schema/dag/revision/v1","title":"Poppy v2 immutable per-run DAG revision","x-poppy-schema-version":"1.0.0","x-poppy-manifest-entry":"schema.dag.revision","type":"object","required":["$schema","x-poppy-schema-version","revision_id","run_id","plan_revision","objective_binding_digest","registry_id","registry_version","registry_digest","node_ids","edge_ids","entry_node_ids","terminal_node_ids","compiled_at","previous_revision_digest","revision_digest"],"properties":{"$schema":{"const":"poppy://schema/dag/revision/v1"},"x-poppy-schema-version":{"const":"1.0.0"},"revision_id":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},"run_id":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},"plan_revision":{"type":"integer","minimum":1},"objective_binding_digest":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/digest"},"registry_id":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:[.][a-z0-9]+)+$"},"registry_version":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/semver"},"registry_digest":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/digest"},"node_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^node[.][a-z0-9]+(?:[.][a-z0-9]+)*$"}},"edge_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^edge[.][a-z0-9-]+(?:[.][a-z0-9-]+)*$"}},"entry_node_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^node[.][a-z0-9]+(?:[.][a-z0-9]+)*$"}},"terminal_node_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^node[.][a-z0-9]+(?:[.][a-z0-9]+)*$"}},"compiled_at":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/timestamp"},"previous_revision_digest":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"},"revision_digest":{"$ref":"poppy://schema/governance/common-definitio