{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"poppy://schema/dag/artifact-reference/v1","title":"Poppy v2 typed artifact reference","x-poppy-schema-version":"1.0.0","x-poppy-manifest-entry":"schema.dag.artifact-reference","type":"object","required":["$schema","x-poppy-schema-version","artifact_id","run_id","plan_revision","producing_node_id","schema_id","schema_version","schema_digest","content_ref","content_digest","material","created_at","reference_digest"],"properties":{"$schema":{"const":"poppy://schema/dag/artifact-reference/v1"},"x-poppy-schema-version":{"const":"1.0.0"},"artifact_id":{"type":"string","pattern":"^artifact[.][a-z0-9]+(?:[.][a-z0-9]+)*$"},"run_id":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},"plan_revision":{"type":"integer","minimum":1},"producing_node_id":{"type":"string","pattern":"^node[.][a-z0-9]+(?:[.][a-z0-9]+)*$"},"schema_id":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/schemaId"},"schema_version":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/semver"},"schema_digest":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/digest"},"content_ref":{"type":"string","pattern":"^synthetic:[^\\u0000]+$"},"content_digest":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/digest"},"material":{"type":"boolean"},"created_at":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/timestamp"},"reference_digest":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/digest"}},"unevaluatedProperties":false}
