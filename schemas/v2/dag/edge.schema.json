{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"poppy://schema/dag/edge/v1","title":"Poppy v2 typed DAG artifact edge","x-poppy-schema-version":"1.0.0","x-poppy-manifest-entry":"schema.dag.edge","type":"object","required":["$schema","x-poppy-schema-version","edge_id","run_id","plan_revision","from_node_id","to_node_id","artifact_name","artifact_schema_id","artifact_schema_version","artifact_schema_digest","required","edge_digest"],"properties":{"$schema":{"const":"poppy://schema/dag/edge/v1"},"x-poppy-schema-version":{"const":"1.0.0"},"edge_id":{"type":"string","pattern":"^edge[.][a-z0-9-]+(?:[.][a-z0-9-]+)*$"},"run_id":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},"plan_revision":{"type":"integer","minimum":1},"from_node_id":{"type":"string","pattern":"^node[.][a-z0-9]+(?:[.][a-z0-9]+)*$"},"to_node_id":{"type":"string","pattern":"^node[.][a-z0-9]+(?:[.][a-z0-9]+)*$"},"artifact_name":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},"artifact_schema_id":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/schemaId"},"artifact_schema_version":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/semver"},"artifact_schema_digest":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/digest"},"required":{"type":"boolean"},"edge_digest":{"$ref":"poppy://schema/governance/common-definitions/v1#/$defs/digest"}},"unevaluatedProperties":false}
