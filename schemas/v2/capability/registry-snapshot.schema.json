{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/capability/registry-snapshot/v1",
  "title": "Poppy v2 immutable capability registry snapshot",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.capability.registry-snapshot",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "registry_id", "registry_version", "registry_digest", "created_at", "contracts", "executor_role_catalog"],
  "properties": {
    "$schema": {"const": "poppy://schema/capability/registry-snapshot/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "registry_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.][a-z0-9]+)+$"},
    "registry_version": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/semver"},
    "registry_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "created_at": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/timestamp"},
    "contracts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "poppy://schema/capability/contract/v1"}},
    "executor_role_catalog": {"$ref": "poppy://schema/capability/executor-role-catalog/v1"}
  },
  "unevaluatedProperties": false
}
