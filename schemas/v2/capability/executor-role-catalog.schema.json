{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/capability/executor-role-catalog/v1",
  "title": "Poppy v2 executor role catalog",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.capability.executor-role-catalog",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "catalog_id", "catalog_version", "catalog_digest", "registration_grants_authority", "roles"],
  "properties": {
    "$schema": {"const": "poppy://schema/capability/executor-role-catalog/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "catalog_id": {"type": "string", "pattern": "^executor-role-catalog[.][a-z0-9]+(?:[.][a-z0-9]+)*$"},
    "catalog_version": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/semver"},
    "catalog_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "registration_grants_authority": {"const": false},
    "roles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["role_id", "executor_kind", "authority_capability"],
        "properties": {
          "role_id": {"type": "string", "pattern": "^executor[.][a-z0-9]+(?:[.][a-z0-9]+)*$"},
          "executor_kind": {"enum": ["root", "internal_worker", "user_owned_task", "human_operator"]},
          "authority_capability": {"const": false}
        },
        "unevaluatedProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
