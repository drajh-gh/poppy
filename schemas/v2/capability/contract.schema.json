{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/capability/contract/v1",
  "title": "Poppy v2 immutable capability contract",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.capability.contract",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "contract_id", "contract_version", "contract_digest", "schema_bindings", "effect_ceiling", "required_claims", "authority_requirements", "permitted_executor_roles", "stable_failure_codes", "implementation_uri", "implementation_digest", "compatibility", "published_at"],
  "properties": {
    "$schema": {"const": "poppy://schema/capability/contract/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "contract_id": {"type": "string", "pattern": "^capability[.][a-z0-9]+(?:[.][a-z0-9]+)*$"},
    "contract_version": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/semver"},
    "contract_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "schema_bindings": {
      "type": "object",
      "required": ["input", "output", "verification"],
      "properties": {
        "input": {"$ref": "poppy://schema/capability/contract-binding/v1#/$defs/schemaBinding"},
        "output": {"$ref": "poppy://schema/capability/contract-binding/v1#/$defs/schemaBinding"},
        "verification": {"$ref": "poppy://schema/capability/contract-binding/v1#/$defs/schemaBinding"}
      },
      "unevaluatedProperties": false
    },
    "effect_ceiling": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["none", "draft", "local_write", "destructive", "archive", "communication", "financial", "deployment", "production", "computer_control"]}},
    "required_claims": {"type": "array", "uniqueItems": true, "items": {"$ref": "poppy://schema/capability/claim-requirement/v1"}},
    "authority_requirements": {"type": "array", "uniqueItems": true, "items": {"$ref": "poppy://schema/capability/authority-requirement-binding/v1"}},
    "permitted_executor_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^executor[.][a-z0-9]+(?:[.][a-z0-9]+)*$"}},
    "stable_failure_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/stableCode"}},
    "implementation_uri": {"type": "string", "pattern": "^poppy://implementation/[a-z0-9-]+(?:/[a-z0-9-]+)*/v[1-9][0-9]*$"},
    "implementation_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "compatibility": {"$ref": "poppy://schema/capability/compatibility-declaration/v1"},
    "published_at": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/timestamp"}
  },
  "unevaluatedProperties": false
}
