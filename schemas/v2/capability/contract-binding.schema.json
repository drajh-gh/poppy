{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/capability/contract-binding/v1",
  "title": "Poppy v2 exact run-to-capability binding",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.capability.contract-binding",
  "$defs": {
    "schemaBinding": {
      "type": "object",
      "required": ["schema_id", "schema_version", "schema_digest"],
      "properties": {
        "schema_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/schemaId"},
        "schema_version": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/semver"},
        "schema_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"}
      },
      "unevaluatedProperties": false
    }
  },
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "run_id", "registry_id", "registry_version", "registry_digest", "contract_id", "contract_version", "contract_digest", "bound_at", "binding_digest"],
  "properties": {
    "$schema": {"const": "poppy://schema/capability/contract-binding/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "run_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
    "registry_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.][a-z0-9]+)+$"},
    "registry_version": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/semver"},
    "registry_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "contract_id": {"type": "string", "pattern": "^capability[.][a-z0-9]+(?:[.][a-z0-9]+)*$"},
    "contract_version": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/semver"},
    "contract_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "bound_at": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/timestamp"},
    "binding_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"}
  },
  "unevaluatedProperties": false
}
