{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/capability/claim-requirement/v1",
  "title": "Poppy v2 capability claim requirement",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.capability.claim-requirement",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "requirement_id", "claim_class", "required_state", "claim_schema", "requirement_digest"],
  "properties": {
    "$schema": {"const": "poppy://schema/capability/claim-requirement/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "requirement_id": {"type": "string", "pattern": "^claim-requirement[.][a-z0-9-]+(?:[.][a-z0-9-]+)*$"},
    "claim_class": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.][a-z0-9]+)+$"},
    "required_state": {"const": "supported"},
    "claim_schema": {"$ref": "poppy://schema/capability/contract-binding/v1#/$defs/schemaBinding"},
    "requirement_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"}
  },
  "unevaluatedProperties": false
}
