{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/capability/authority-requirement-binding/v1",
  "title": "Poppy v2 capability authority requirement",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.capability.authority-requirement-binding",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "requirement_id", "subject_kind", "effect_classes", "required_outcome", "authority_schema", "distinct_human_approval_required", "registration_grants_authority", "requirement_digest"],
  "properties": {
    "$schema": {"const": "poppy://schema/capability/authority-requirement-binding/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "requirement_id": {"type": "string", "pattern": "^authority-requirement[.][a-z0-9-]+(?:[.][a-z0-9-]+)*$"},
    "subject_kind": {"enum": ["claim", "effect"]},
    "effect_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["draft", "local_write", "destructive", "archive", "communication", "financial", "deployment", "production", "computer_control"]}},
    "required_outcome": {"const": "authorized"},
    "authority_schema": {"$ref": "poppy://schema/capability/contract-binding/v1#/$defs/schemaBinding"},
    "distinct_human_approval_required": {"type": "boolean"},
    "registration_grants_authority": {"const": false},
    "requirement_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"}
  },
  "unevaluatedProperties": false
}
