{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/effect/proposal/v1",
  "title": "Poppy v2 immutable effect proposal",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.effect.proposal",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "effect_id", "effect_class", "objective_digest", "plan_revision", "target", "preview_digest", "reversibility", "rollback", "verification", "authority_resolution_id", "authority_resolution_digest", "authority_ref", "authority_principal_kind", "high_risk_approval_ref", "effect_digest", "proposed_at", "proposer_role"],
  "properties": {
    "$schema": {"const": "poppy://schema/effect/proposal/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "effect_id": {"type": "string", "pattern": "^effect[.-][a-z0-9.-]+$"},
    "effect_class": {"enum": ["draft", "local_write", "destructive", "archive", "communication", "financial", "deployment", "production", "computer_control"]},
    "objective_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "target": {"$ref": "poppy://schema/effect/target/v1"},
    "preview_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "reversibility": {"enum": ["reversible", "compensable", "irreversible"]},
    "rollback": {"$ref": "poppy://schema/effect/rollback-plan/v1"},
    "verification": {"$ref": "poppy://schema/effect/verification-plan/v1"},
    "authority_resolution_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
    "authority_resolution_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "authority_ref": {"type": "string", "minLength": 1},
    "authority_principal_kind": {"enum": ["platform", "human", "standing_automation"]},
    "high_risk_approval_ref": {"type": ["string", "null"]},
    "effect_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "proposed_at": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/timestamp"},
    "proposer_role": {"enum": ["root", "internal_worker", "user_owned_task", "human_operator"]}
  },
  "unevaluatedProperties": false
}
