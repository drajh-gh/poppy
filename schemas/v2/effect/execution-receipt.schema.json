{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/effect/execution-receipt/v1",
  "title": "Poppy v2 effect execution receipt",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.effect.execution-receipt",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "receipt_id", "effect_id", "effect_digest", "objective_digest", "plan_revision", "target", "preview_digest", "authority_resolution_id", "authority_resolution_digest", "authority_ref", "attempt_id", "attempted_at", "attempt_outcome", "verification_state", "verification_evidence_refs", "verified_at", "executor_role", "receipt_digest"],
  "properties": {
    "$schema": {"const": "poppy://schema/effect/execution-receipt/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "receipt_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
    "effect_id": {"type": "string", "pattern": "^effect[.-][a-z0-9.-]+$"},
    "effect_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "objective_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "target": {"$ref": "poppy://schema/effect/target/v1"},
    "preview_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "authority_resolution_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
    "authority_resolution_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"},
    "authority_ref": {"type": "string", "minLength": 1},
    "attempt_id": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/uuidV7"},
    "attempted_at": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/timestamp"},
    "attempt_outcome": {"enum": ["succeeded", "failed", "partial"]},
    "verification_state": {"enum": ["verified", "failed", "gray", "not_attempted"]},
    "verification_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^synthetic:[^\\u0000]+$"}},
    "verified_at": {"type": ["string", "null"], "format": "date-time"},
    "executor_role": {"enum": ["root", "internal_worker", "user_owned_task", "human_operator"]},
    "receipt_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"}
  },
  "unevaluatedProperties": false
}
