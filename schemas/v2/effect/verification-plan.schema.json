{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poppy://schema/effect/verification-plan/v1",
  "title": "Poppy v2 effect verification plan",
  "x-poppy-schema-version": "1.0.0",
  "x-poppy-manifest-entry": "schema.effect.verification-plan",
  "type": "object",
  "required": ["$schema", "x-poppy-schema-version", "verification_plan_id", "kind", "expected_state_digest", "criteria", "verifier_role", "plan_digest"],
  "properties": {
    "$schema": {"const": "poppy://schema/effect/verification-plan/v1"},
    "x-poppy-schema-version": {"const": "1.0.0"},
    "verification_plan_id": {"type": "string", "pattern": "^verification[.-][a-z0-9.-]+$"},
    "kind": {"enum": ["content_digest_readback", "state_readback", "provider_readback", "receipt_confirmation", "manual_observation"]},
    "expected_state_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verifier_role": {"enum": ["root", "internal_worker", "human_operator", "provider"]},
    "plan_digest": {"$ref": "poppy://schema/governance/common-definitions/v1#/$defs/digest"}
  },
  "unevaluatedProperties": false
}
