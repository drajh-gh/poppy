{
  "schema_version": 1,
  "packet_type": "capability-graph",
  "graph_id": "poppy-project-operations",
  "trigger": {
    "canonical_name": "Poppy",
    "aliases": [
      "Project Operations Partner"
    ],
    "match": "case-insensitive-explicit-mention",
    "non_trigger": "Do not force Poppy routing when neither Poppy nor Project Operations Partner is explicitly mentioned."
  },
  "interaction_classes": [
    "simple",
    "bounded-advisory",
    "substantive-read",
    "mutating"
  ],
  "confidence_levels": [
    "high",
    "medium",
    "low",
    "insufficient"
  ],
  "delegation_limits": {
    "max_depth": 1,
    "max_active_workers": 2,
    "max_created_workers": 5
  },
  "nodes": [
    {
      "id": "trigger",
      "kind": "control",
      "handler": "poppy",
      "execution": "root-only",
      "inputs": ["trusted-user-turn"],
      "outputs": ["trigger-context"]
    },
    {
      "id": "triage",
      "kind": "control",
      "handler": "poppy",
      "execution": "root-only",
      "inputs": ["trigger-context"],
      "outputs": ["interaction-class", "candidate-objective"]
    },
    {
      "id": "project-resolve",
      "kind": "control",
      "handler": "poppy",
      "execution": "root-only",
      "inputs": ["candidate-objective"],
      "outputs": ["project-context", "project-resolution-gap"]
    },
    {
      "id": "readiness-screen",
      "kind": "evaluation",
      "handler": "project-ops-evaluate",
      "execution": "root-only",
      "inputs": ["candidate-objective", "project-context"],
      "outputs": ["initial-confidence", "risk-floor", "orientation-decision"]
    },
    {
      "id": "direct-answer",
      "kind": "capability",
      "handler": "poppy",
      "execution": "root-only",
      "inputs": ["initial-confidence"],
      "outputs": ["answer"]
    },
    {
      "id": "memory-orient",
      "kind": "memory",
      "handler": "project-ops-memory",
      "execution": "root-only",
      "inputs": ["orientation-decision"],
      "outputs": ["bounded-working-set", "freshness-gaps", "authority-context"]
    },
    {
      "id": "preflight-evaluate",
      "kind": "evaluation",
      "handler": "project-ops-evaluate",
      "execution": "root-only",
      "inputs": ["bounded-working-set"],
      "outputs": ["preflight-packet", "execution-disposition"]
    },
    {
      "id": "needs-user-decision",
      "kind": "authority",
      "handler": "poppy",
      "execution": "root-only",
      "inputs": ["initial-confidence", "project-resolution-gap", "execution-disposition"],
      "outputs": ["resolved-decision", "safe-stopped-state"]
    },
    {
      "id": "dispatch",
      "kind": "control",
      "handler": "poppy",
      "execution": "root-only",
      "inputs": ["execution-disposition", "resolved-decision"],
      "outputs": ["selected-subgraph", "worker-plan"]
    },
    {
      "id": "knowledge-query",
      "kind": "capability",
      "handler": "project-ops-memory",
      "execution": "root-or-worker",
      "inputs": ["selected-subgraph"],
      "outputs": ["evidence-backed-answer"]
    },
    {
      "id": "source-refresh",
      "kind": "capability",
      "handler": "project-ops-memory",
      "execution": "root-or-worker",
      "inputs": ["selected-subgraph"],
      "outputs": ["source-receipts", "compiled-memory-delta"]
    },
    {
      "id": "intake-reconcile",
      "kind": "capability",
      "handler": "project-ops-manager",
      "execution": "root-only",
      "inputs": ["selected-subgraph"],
      "outputs": ["deduplicated-intake", "intake-dispositions"]
    },
    {
      "id": "raid-control",
      "kind": "capability",
      "handler": "project-ops-manager",
      "execution": "root-only",
      "inputs": ["selected-subgraph", "deduplicated-intake"],
      "outputs": ["raid-assessment", "raid-actions"]
    },
    {
      "id": "architecture",
      "kind": "capability",
      "handler": "project-ops-architect",
      "execution": "root-or-worker",
      "inputs": ["selected-subgraph"],
      "outputs": ["operating-design", "adapter-contract"]
    },
    {
      "id": "onboarding",
      "kind": "capability",
      "handler": "project-ops-onboard",
      "execution": "root-only",
      "inputs": ["selected-subgraph", "operating-design"],
      "outputs": ["validated-profile", "vault-scaffold", "accepted-gaps"]
    },
    {
      "id": "operations-control",
      "kind": "capability",
      "handler": "project-ops-manager",
      "execution": "root-only",
      "inputs": ["selected-subgraph"],
      "outputs": ["ranked-actions", "decision-queue"]
    },
    {
      "id": "health-reporting",
      "kind": "capability",
      "handler": "project-ops-health",
      "execution": "root-or-worker",
      "inputs": ["selected-subgraph", "decision-queue", "raid-assessment"],
      "outputs": ["health-snapshot", "status-draft"]
    },
    {
      "id": "commercial-control",
      "kind": "capability",
      "handler": "project-ops-finance",
      "execution": "root-or-worker",
      "inputs": ["selected-subgraph", "decision-queue", "health-snapshot"],
      "outputs": ["budget-snapshot", "commercial-decisions"]
    },
    {
      "id": "meeting-intelligence",
      "kind": "capability",
      "handler": "project-ops-meetings",
      "execution": "root-or-worker",
      "inputs": ["selected-subgraph"],
      "outputs": ["meeting-brief", "meeting-record", "follow-up-draft"]
    },
    {
      "id": "communications",
      "kind": "capability",
      "handler": "project-ops-manager",
      "execution": "root-only",
      "inputs": ["selected-subgraph", "ranked-actions", "follow-up-draft", "incident-orientation"],
      "outputs": ["communication-draft", "follow-up-plan"]
    },
    {
      "id": "stakeholder-control",
      "kind": "capability",
      "handler": "project-ops-manager",
      "execution": "root-only",
      "inputs": ["selected-subgraph", "meeting-record"],
      "outputs": ["stakeholder-attention", "commitment-follow-up"]
    },
    {
      "id": "change-control",
      "kind": "capability",
      "handler": "project-ops-manager",
      "execution": "root-only",
      "inputs": ["selected-subgraph", "commercial-decisions", "meeting-record"],
      "outputs": ["change-classification", "approval-path"]
    },
    {
      "id": "incident-response",
      "kind": "capability",
      "handler": "project-ops-manager",
      "execution": "root-only",
      "inputs": ["selected-subgraph"],
      "outputs": ["incident-orientation", "remediation-decision"]
    },
    {
      "id": "portfolio",
      "kind": "capability",
      "handler": "project-ops-portfolio",
      "execution": "root-only",
      "inputs": ["selected-subgraph"],
      "outputs": ["sanitized-portfolio-review"]
    },
    {
      "id": "automation",
      "kind": "capability",
      "handler": "project-ops-automate",
      "execution": "root-only",
      "inputs": ["selected-subgraph"],
      "outputs": ["automation-preview", "automation-receipt"]
    },
    {
      "id": "delivery",
      "kind": "capability",
      "handler": "project-ops-delivery",
      "execution": "root-only",
      "inputs": ["selected-subgraph", "remediation-decision", "upgrade-candidate"],
      "outputs": ["frozen-delivery-evidence"]
    },
    {
      "id": "functional-qa",
      "kind": "assessment",
      "handler": "project-ops-assess",
      "execution": "fresh-worker",
      "inputs": ["frozen-delivery-evidence"],
      "outputs": ["functional-qa-verdict"]
    },
    {
      "id": "final-assurance",
      "kind": "assessment",
      "handler": "project-ops-assess",
      "execution": "fresh-worker",
      "inputs": ["functional-qa-verdict"],
      "outputs": ["final-assurance-verdict"]
    },
    {
      "id": "research",
      "kind": "capability",
      "handler": "project-ops-researcher",
      "execution": "root-or-worker",
      "inputs": ["selected-subgraph", "sanitized-portfolio-review"],
      "outputs": ["validated-research-packet"]
    },
    {
      "id": "improvement",
      "kind": "capability",
      "handler": "project-ops-upgrader",
      "execution": "root-only",
      "inputs": ["selected-subgraph", "validated-research-packet"],
      "outputs": ["improvement-disposition", "upgrade-candidate"]
    },
    {
      "id": "join",
      "kind": "control",
      "handler": "poppy",
      "execution": "root-only",
      "inputs": ["evidence-backed-answer", "compiled-memory-delta", "deduplicated-intake", "raid-assessment", "operating-design", "validated-profile", "ranked-actions", "health-snapshot", "budget-snapshot", "meeting-record", "communication-draft", "stakeholder-attention", "change-classification", "incident-orientation", "sanitized-portfolio-review", "automation-preview", "frozen-delivery-evidence", "final-assurance-verdict", "validated-research-packet", "improvement-disposition"],
      "outputs": ["complete-required-outputs", "missing-required-outputs"]
    },
    {
      "id": "reconcile",
      "kind": "control",
      "handler": "poppy",
      "execution": "root-only",
      "inputs": ["complete-required-outputs"],
      "outputs": ["reconciled-result", "proposed-effects"]
    },
    {
      "id": "human-approval",
      "kind": "authority",
      "handler": "poppy",
      "execution": "root-only",
      "inputs": ["proposed-effects"],
      "outputs": ["bounded-authority-decision"]
    },
    {
      "id": "authorized-execution",
      "kind": "authority",
      "handler": "selected-capability-handler",
      "execution": "root-only",
      "inputs": ["proposed-effects", "bounded-authority-decision"],
      "outputs": ["verified-effects", "mutation-receipt"]
    },
    {
      "id": "postflight-evaluate",
      "kind": "evaluation",
      "handler": "project-ops-evaluate",
      "execution": "root-or-fresh-worker",
      "inputs": ["answer", "reconciled-result", "verified-effects"],
      "outputs": ["postflight-verdict", "final-confidence", "residual-risk"]
    },
    {
      "id": "memory-close",
      "kind": "memory",
      "handler": "project-ops-memory",
      "execution": "root-only",
      "inputs": ["postflight-verdict"],
      "outputs": ["durable-memory-delta", "audit-receipt"]
    },
    {
      "id": "terminal",
      "kind": "control",
      "handler": "poppy",
      "execution": "root-only",
      "inputs": ["safe-stopped-state", "bounded-authority-decision", "postflight-verdict", "audit-receipt"],
      "outputs": ["final-state", "next-action"]
    }
  ],
